{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.6",
  "trustedDependencies": [
    "@sentry/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "eas-build-pre-install": "node scripts/eas-preinstall-cleanup.mjs",
    "start": "npx expo start",
    "start:local": "npx expo start",
    "start:web": "bunx expo start --web --port 8081 --clear",
    "start:android:usb": "node scripts/start-android-usb.mjs",
    "start:dev:tunnel": "bunx expo start --tunnel --clear",
    "start-web": "bunx expo start --web --port 8081 --clear",
    "start-web-dev": "DEBUG=expo* bunx expo start --web --port 8081 --clear",
    "start:backend": "tsx backend/server.ts",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --silent",
    "lint": "expo lint",
    "android": "node scripts/expo-run-android.mjs",
    "android:win": "scripts\\windows-android-build.cmd",
    "android:bun": "bun scripts/expo-run-android.mjs",
    "ios": "expo run:ios",
    "e2e:prebuild": "npx expo prebuild --platform android",
    "e2e:build:android": "node ./scripts/detox-android-build.js",
    "e2e:test:android": "node ./scripts/with-android-sdk.js",
    "e2e:test:android:device": "node ./scripts/with-android-sdk.js npx detox test --configuration android.att.debug",
    "e2e:list-avds": "node ./scripts/list-e2e-avds.js",
    "e2e:metro": "npx expo start",
    "e2e:android": "npm run e2e:build:android && npm run e2e:test:android",
    "db:generate-sql": "tsx scripts/generate-questions-sql.ts",
    "db:migrate": "tsx scripts/migrate-questions-to-supabase.ts",
    "db:migrate:clear": "tsx scripts/migrate-questions-to-supabase.ts --clear",
    "apple:jwt-supabase": "node scripts/generate-apple-jwt-supabase.mjs",
    "release:decode-jwt": "node scripts/decode-jwt-payload.mjs",
    "verify:auth-session": "node scripts/verify-auth-session.mjs",
    "audit:head-neck-i18n": "tsx scripts/audit-head-neck-i18n.ts",
    "audit:locales-en-ro": "tsx scripts/audit-locale-en-ro.ts",
    "audit:quiz-missing-ro": "bun scripts/audit-quiz-missing-ro.ts",
    "audit:app-en-ro": "bun scripts/audit-app-en-ro.ts",
    "translate:quiz-ro": "bun scripts/batch-translate-quiz-ro.ts",
    "merge:ro-delta": "bun scripts/merge-ro-delta-apply.ts",
    "list:chapters": "tsx scripts/list-chapters.ts",
    "build:head-neck-home": "tsx scripts/build-head-neck-home-questions.ts",
    "translate:head-neck-home-ro": "tsx scripts/translate-head-neck-home-ro.ts",
    "normalize:head-neck-continued": "tsx scripts/normalize-head-neck-continued-bilingual.ts",
    "study:generate": "tsx scripts/generate-chapter-summaries.ts",
    "study:translate-en": "tsx scripts/translate-study-ro-to-en.ts",
    "study:reformat": "tsx scripts/reformat-study-drafts.ts",
    "study:build-bundle": "tsx scripts/build-study-full-bundle.ts",
    "study:seed-internal-organs": "tsx scripts/seed-internal-organs-pilot.ts",
    "study:seed-internal-organs-en": "tsx scripts/seed-internal-organs-en.ts",
    "study:validate-en": "tsx scripts/validate-study-en-drafts.ts",
    "study:publish": "tsx scripts/publish-study-content.ts",
    "study:publish-all": "tsx scripts/publish-all-study-drafts.ts",
    "study:audio": "tsx scripts/generate-study-audio.ts",
    "study:audio-batch": "tsx scripts/generate-study-audio-batch.ts",
    "study:sync-preview-audio": "tsx scripts/sync-preview-audio-urls.ts",
    "doctor": "node scripts/postinstall-dedupe-kinde-expo.mjs && expo-doctor",
    "release:preflight": "bun install --frozen-lockfile && bun run doctor && bunx tsc --noEmit",
    "build:dev:android": "node scripts/eas-build.mjs development",
    "build:aab": "node scripts/eas-build.mjs production",
    "release:android": "node scripts/eas-build.mjs production",
    "release:artifacts": "node scripts/eas-download-release-artifacts.mjs --latest",
    "postinstall": "node scripts/postinstall-dedupe-kinde-expo.mjs",
    "prepare": "node scripts/postinstall-dedupe-kinde-expo.mjs"
  },
