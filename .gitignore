# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# Use Bun only: commit bun.lock. Do not commit package-lock.json (confuses expo-doctor / EAS package manager detection).
package-lock.json
yarn.lock
pnpm-lock.yaml

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (iOS generated locally / CI; Android is versioned for bare workflow)
android/.kotlin/
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# App Store Connect API key for eas submit (local only)
secrets/

# local env files and secrets (never commit)
.env
.env*.local
.env.production
.env.*.local

# typescript
*.tsbuildinfo
.vercel

.rork

rork-eslint.config.js

# Generated audit / batch reports (local only)
scripts/*-report.txt

# EAS release downloads (AAB, mapping.txt zip — local only)
release-artifacts/

# Study source books (Archive PDF / OCR — local only)
content/study/sources/

# Local script inventories (regenerate with list:chapters)
scripts/output/

# Supabase CLI temp (pooler URLs, local state — never commit)
supabase/.temp/