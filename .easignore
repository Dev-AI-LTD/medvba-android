# Do NOT list bun.lock here — EAS must upload it so installs match `bun install --frozen-lockfile`
# (same tree as local). Ignoring it leaves npm without package-lock.json → Doctor warning + flaky Gradle.

# Stray npm/yarn locks (gitignored locally) still get uploaded; exclude them so expo-doctor passes.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Use CNG/Prebuild on EAS even though android/ is versioned locally.
/android
