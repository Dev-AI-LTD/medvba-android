# ===========================================
# MEDVBA – variabile pentru build Google Play
# ===========================================
# Copiază acest fișier ca .env și completează valorile.
# NU comite niciodată .env în git (e în .gitignore). Secretele rămân doar local / EAS / Railway.
# Pentru EAS Build: folosești EAS Secrets (Dashboard sau eas env:create).

# ---------- Supabase (database only — login is handled by Cognito) ----------
EXPO_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXX

# ---------- RevenueCat (abonamente – Google Play / App Store) ----------
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=

# Paywall activ: true = limită zilnică + upgrade, false = totul gratuit
EXPO_PUBLIC_PAYWALL_ENABLED=true

# ---------- Backend API (client — Bază URL Hono + tRPC pe Railway) ----------
EXPO_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app

# ---------- Opțional: Sentry (erori / crash reporting în app) ----------
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------- AWS Cognito (REQUIRED — handles all auth: email/password + social) ----------
# Deploy the CDK stack in infra/ to provision these resources.
# After deploy, copy the stack outputs here and to EAS Secrets.
#
# Setup checklist:
#   1. cd infra && npm install && npx cdk deploy
#   2. Copy output values below
#   3. In Cognito Hosted UI domain, add to each social provider's redirect URIs:
#        https://<domain>.auth.<region>.amazoncognito.com/oauth2/idpresponse
#   4. Run DB migrations 037 and 038 against your Supabase instance
#
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_COGNITO_DOMAIN=medvba.auth.us-east-1.amazoncognito.com

# ---------- DEPRECATED — no longer needed (Cognito Hosted UI handles social login) ----------
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_APP_ID=
# EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
# EXPO_PUBLIC_APPLE_CLIENT_ID=
# EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URI=

# ---------- Backend local (Hono + tRPC) — NU în EAS, NU EXPO_PUBLIC pentru secrete ----------
# SUPABASE_URL=https://XXXXXXXX.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# AI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# CORS_ALLOWED_ORIGINS=https://app.tudomeniu.com
