# ===========================================
# MEDVBA – variabile pentru build Google Play
# ===========================================
# Copiază acest fișier ca .env și completează valorile.
# NU comite niciodată .env în git (e în .gitignore). Secretele rămân doar local / EAS / Railway.
# Pentru EAS Build: folosești EAS Secrets (Dashboard sau eas env:create).
#
# ---------- EAS / expo.dev — același conținut ca .env, dar în cloud ----------
# În Expo Dashboard: proiect MEDVBA (slug medvba) → Environment variables → environment **production**
# (profilul `production` din eas.json). Adaugă manual fiecare EXPO_PUBLIC_* de mai jos cu valorile reale.
# CLI: `npx eas-cli env:create --help` (alege environment production, scope project).
# După modificare: pornește un build NOU — buildurile vechi nu preiau variabilele retroactiv.
# IMPORTANT: la EAS, `app.config.ts` setează EXPO_PUBLIC_PAYWALL_ENABLED la false implicit dacă lipsește
# variabila în cloud. Pentru paywall activ în release Play, setează explicit EXPO_PUBLIC_PAYWALL_ENABLED=true
# în Environment variables (production).
#
# Expo încarcă în app.config.ts doar cheile EXPO_PUBLIC_* de mai jos (plus procesul de build
# poate injecta EXPO_PUBLIC_SENTRY_DSN). Nu pune niciodată chei OpenAI sau service_role
# în EXPO_PUBLIC_* — ele apar în bundle-ul clientului.
# Nu defini EXPO_PUBLIC_AI_API_KEY: backend-ul folosește doar AI_API_KEY / OPENAI_API_KEY (vezi secțiunea backend).

# ---------- Supabase (client — login, progres utilizator) ----------
EXPO_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXX

# ---------- RevenueCat (abonamente – Google Play / App Store) ----------
# Copiază EXACT ce îți arată RevenueCat pentru fiecare aplicație.
# Android: RevenueCat → Project → API Keys → aplicația ANDROID (Google Play) → Public key (de obicei goog_...)
# iOS:     RevenueCat → Project → API Keys → aplicația iOS (App Store)     → Public key (de obicei appl_...)
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=

# Paywall: true = limite free + upgrade (contor quiz total, nu pe zi); false = totul gratuit
# În dev fără această linie, app.config pornește paywall-ul implicit (nu pe build-uri EAS).
EXPO_PUBLIC_PAYWALL_ENABLED=true

# Profil: interogare periodică „Zoom session requests” (tabel zoom_requests). Implicit false — pune true dacă folosești funcția.
# EXPO_PUBLIC_FETCH_ZOOM_REQUESTS=true

# ---------- Backend API (client — Bază URL Hono + tRPC pe Railway) ----------
# Folosit de lib/trpc.ts și de login email+parolă (POST /api/auth/session). Trebuie același host
# ca deployment-ul Railway unde ai setat KINDE_* pentru password grant.
# În producție trebuie să fie HTTPS. Obligatoriu: https:// (două bare după https:), nu https:/
# Folosește rădăcina hostului API (ex. https://your-backend.up.railway.app), fără sufix /api —
# altfel cererile merg la /api/api/auth/... și primești HTTP 404 la login / înregistrare.
EXPO_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app
# Opțional — diagnostic fără app: `bun run verify:auth-session` (vezi scripts/verify-auth-session.mjs)
# VERIFY_AUTH_EMAIL=
# VERIFY_AUTH_PASSWORD=

# ---------- Opțional: Sentry (erori / crash reporting în app) ----------
# NU e listat în app.config extra; dacă e setat la EAS build, e disponibil ca EXPO_PUBLIC_*.
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ---------- Autentificare MEDVBA (Expo — Google / Apple / email) ----------
# Ghid SDK: https://docs.kinde.com/developer-tools/sdks/native/expo/
# În panoul furnizorului de identitate: Applications → Callback URLs / Logout URLs — include scheme-ul app (ex. medvba://*).
EXPO_PUBLIC_KINDE_ISSUER_URL=https://YOUR_SUBDOMAIN.kinde.com
EXPO_PUBLIC_KINDE_CLIENT_ID=your_frontend_client_id
# Opțional — override OAuth scopes (implicit: openid profile email offline, vezi @kinde/expo readme).
# EXPO_PUBLIC_KINDE_SCOPES=openid profile email offline

# Conexiuni sociale (opțional — sari peste pagina „alege furnizorul” când sunt setate).
# Authentication → Social connections → Google / Facebook → copiază **Connection ID**.
# Google (hosted): completează Connection ID ca să sari peste lista de furnizori.
EXPO_PUBLIC_KINDE_GOOGLE_CONNECTION_ID=
EXPO_PUBLIC_KINDE_FACEBOOK_CONNECTION_ID=

# Facebook în login/signup: implicit ACTIV (buton lângă Google). În Kinde trebuie activată conexiunea Facebook pentru cont.
# Ascunde butonul: EXPO_PUBLIC_FACEBOOK_LOGIN_ENABLED=false sau EXPO_PUBLIC_SHOW_FACEBOOK_LOGIN=false
# EXPO_PUBLIC_SHOW_FACEBOOK_LOGIN=false
# EXPO_PUBLIC_FACEBOOK_LOGIN_ENABLED=false

# ---------- Backend local (Hono + tRPC) — NU în EAS, NU EXPO_PUBLIC pentru secrete ----------
# Doar dacă rulezi backend-ul local (ex. tsx backend/server.ts). Aceleași nume ca pe Railway.
# Diagnostic: GET /health (env flags) și GET /api/health (citire reală subscriptions cu service role).
# În producție, detaliile Supabase pe /api/health apar doar cu HEALTHCHECK_VERBOSE=true.
# HEALTHCHECK_VERBOSE=true
# Mesaje TRPC „subscription status” cu cod PostgREST în corp: MEDVBA_VERBOSE_ERRORS=true (sau NODE_ENV≠production).
# MEDVBA_VERBOSE_ERRORS=true
# Tutor AI folosește lib/ai-provider.ts din backend (backend/trpc/tutor.ts) — cheia OpenAI NU
# există în client; setezi una dintre variabilele de mai jos pe server (Railway sau aici).
# Dacă ai EXPO_PUBLIC_AI_API_KEY în .env, șterge-o și folosește doar AI_API_KEY sau OPENAI_API_KEY aici.
#
# SUPABASE_URL=https://XXXXXXXX.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# ---------- Backend: identitate + JWT pentru Postgres (Railway / local) ----------
# CRITICAL: Secretul folosit la semnarea JWT pentru PostgREST trebuie să fie IDENTIC cu
# Supabase Dashboard → Project Settings → API → JWT Secret (HS256).
# Backend: SUPABASE_JWT_SIGNING_SECRET (preferat) SAU fallback KINDE_CLIENT_SECRET
# (vezi backend/auth/mint-supabase-jwt.ts). Nu rotați unul fără celălalt.
#
# KINDE_ISSUER_URL=https://YOUR_SUBDOMAIN.kinde.com
# KINDE_CLIENT_ID=același client folosit de aplicația native/Expo
# KINDE_CLIENT_SECRET=secretul acelui client — obligatoriu pe server pentru login email+parolă (password grant)
# În Kinde: Applications → aplicația ta → tab Authentication / Grant types → permite „Password”
# (resource owner / ROPC — denumirea exactă poate varia; vezi doc Kinde „password grant”).
# Fără asta, POST /api/auth/session returnează 401; M2M nu rezolvă loginul email.
# KINDE_AUDIENCE=opțional, dacă token-ul password cere audience — dacă loginul email eșuează misterios, lasă gol (nu seta același lucru ca la M2M decât dacă știi că e cerut).
#
# Înscriere email+parolă fără browser (POST /api/auth/register): aplicație Machine-to-Machine în Kinde
# → APIs → Kinde Management API → Authorize app → permisiuni create user / set password / delete users
# (delete users e necesar ca ștergerea contului din app să elibereze emailul în Kinde pentru reînregistrare).
# KINDE_M2M_CLIENT_ID=client_id_ul_aplicației_M2M
# KINDE_M2M_CLIENT_SECRET=client_secret_ul_M2M
# Opțional — dacă Kinde cere scope explicit la token M2M, pune aceleași scope-uri ca în APIs → Manage scopes (ex. read:users write:users), separate prin spațiu.
# KINDE_M2M_TOKEN_SCOPE=read:users write:users
# KINDE_MANAGEMENT_AUDIENCE=opțional; implicit https://<subdomain>.kinde.com/api
# KINDE_REGISTER_ORG_CODE=opțional — cod organizație Kinde dacă utilizatorii noi trebuie creați într-o org. anume
#
# SUPABASE_JWT_SIGNING_SECRET=recomandat: același string ca „JWT Secret” din Supabase (poate fi egal cu KINDE_CLIENT_SECRET dacă urmezi integrarea HS256 cu furnizorul de identitate)
# AI_API_KEY=sk-...                    # recomandat (sau OPENAI_API_KEY)
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# CORS_ALLOWED_ORIGINS=https://app.tudomeniu.com
#
# ---------- RevenueCat webhooks (doar server — sincronizare subscriptions din IAP) ----------
# Dashboard → Integrations → Webhooks → URL POST https://YOUR-HOST/api/webhooks/revenuecat
# Configurează același secret la „Authorization header”; request trebuie să fie Authorization: Bearer <secret>
# (backend acceptă și secretul fără prefix Bearer).
# REVENUECAT_WEBHOOK_AUTHORIZATION=un-secret-lung-aleator
# Dacă entitlement ID nu este „pro” (vezi constants/subscription ENTITLEMENT_ID):
# Secret API key („REST API / Secret key” în RevenueCat) — folosit doar pe server la GET /v1/subscribers după webhook.
# Opțional: alias REVENUECAT_API_SECRET_KEY
# REVENUECAT_SECRET_API_KEY=
