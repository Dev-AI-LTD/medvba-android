# Copy to `.env` and fill in real values. Never commit `.env`.
# Official App Store / TestFlight review account: contact@devaieood.com (verified in Kinde).

# --- Kinde (Expo native app — one application for iOS + Android) ---
EXPO_PUBLIC_KINDE_ISSUER_URL=https://YOUR_SUBDOMAIN.kinde.com
EXPO_PUBLIC_KINDE_CLIENT_ID=
EXPO_PUBLIC_KINDE_APPLE_CONNECTION_ID=
EXPO_PUBLIC_KINDE_GOOGLE_CONNECTION_ID=
EXPO_PUBLIC_KINDE_EMAIL_CONNECTION_ID=
# EXPO_PUBLIC_KINDE_SCOPES=openid profile email offline

# --- Backend (Railway) + Supabase ---
EXPO_PUBLIC_API_BASE_URL=https://your-app.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat (public keys only) ---
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_
EXPO_PUBLIC_PAYWALL_ENABLED=true

# --- App Store review (local scripts + optional EAS production) ---
VERIFY_AUTH_EMAIL=contact@devaieood.com
VERIFY_AUTH_PASSWORD=
VERIFY_AUTH_NAME=App Review
EXPO_PUBLIC_KINDE_LOGIN_HINT_EMAIL=contact@devaieood.com
EXPO_PUBLIC_APP_REVIEW_PREMIUM_EMAILS=contact@devaieood.com
# true for TestFlight / App Review builds (EAS production); false for public App Store
EXPO_PUBLIC_ENABLE_REVIEW_PREMIUM=true

# --- Local scripts only (never in EAS / never EXPO_PUBLIC_) ---
# SUPABASE_SERVICE_ROLE_KEY=
# KINDE_M2M_CLIENT_ID=
# KINDE_M2M_CLIENT_SECRET=

# --- Optional ---
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SUPPORT_EMAIL=contact@devaieood.com
# EXPO_PUBLIC_SHOW_FACEBOOK_LOGIN=false
