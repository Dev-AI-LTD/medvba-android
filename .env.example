# Copy to .env and fill values. Never commit .env.

# --- Supabase client (app) ---
EXPO_PUBLIC_SUPABASE_URL=https://utbcxdtcznitejbhhquh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- Supabase server (backend / scripts) ---
SUPABASE_URL=https://utbcxdtcznitejbhhquh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# --- Supabase Postgres (CLI, npm run db:run-sql, npm run supabase) ---
# Org: DEV.AI.EOOD → Medix Study Hub → Database → password
# Postgres direct (migrări SQL / npm run supabase / db:run-sql)
SUPABASE_PROJECT_REF=utbcxdtcznitejbhhquh
SUPABASE_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SUPABASE_DB_PORT=6543

# Clinical Copilot — keep false for public store builds
EXPO_PUBLIC_CLINICAL_COPILOT_ENABLED=false
# CLINICAL_COPILOT_ENABLED=false

# --- RevenueCat (public SDK keys in Expo; secrets only on Railway) ---
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_...
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_...
# Optional; defaults accept both medvba_pro_ai and legacy pro:
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=medvba_pro_ai
# Server only (Railway):
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_WEBHOOK_AUTHORIZATION=your_webhook_bearer_secret
# REVENUECAT_WEBHOOK_AUTH_TOKEN=   # alias for AUTHORIZATION
# REVENUECAT_ENTITLEMENT_ID=medvba_pro_ai
